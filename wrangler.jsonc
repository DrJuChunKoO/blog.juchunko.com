{
  "name": "blog-juchunko",
  "compatibility_date": "2025-06-17",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/**/*.mp4"]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "blog.juchunko.com",
      "custom_domain": true
    }
  ]
}
