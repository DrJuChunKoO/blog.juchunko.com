---
import BaseHead from "../../../../../components/BaseHead.astro";
import Header from "../../../../../components/Header.astro";
import Footer from "../../../../../components/Footer.astro";
import CategorySelect from "../../../../../components/CategorySelect.astro";
import PaginationNav from "../../../../../components/PaginationNav.astro";
import PostGrid from "../../../../../components/PostGrid.astro";
import { SITE_DESCRIPTION } from "../../../../../consts";
import { getCollection } from "astro:content";
import { languages } from "../../../../../i18n/ui";
import {
  FEATURED_FIRST_PAGE_POSTS,
  getCategorySummaries,
  getPostsForCategory,
  getPostsForLang,
  paginateItems,
  type Language,
} from "../../../../../lib/blog";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  const langs = Object.keys(languages) as Language[];
  const paths = await Promise.all(
    categories.flatMap((cat) =>
      langs.map(async (lang) => {
        const categoryPosts = await getPostsForCategory(lang, cat.id);
        const { totalPages } = paginateItems(
          categoryPosts,
          1,
          undefined,
          FEATURED_FIRST_PAGE_POSTS,
        );

        return Array.from(
          { length: Math.max(totalPages - 1, 0) },
          (_, index) => ({
            params: { lang, category: cat.id, page: String(index + 2) },
          }),
        );
      }),
    ),
  );

  return paths.flat();
}

const { lang, category, page } = Astro.params;
const currentLang = lang as Language;
const categoryId = category ?? "";
const requestedPage = Number(page);
const [allPosts, allCategories, categoryPosts] = await Promise.all([
  getPostsForLang(currentLang),
  getCategorySummaries(currentLang),
  getPostsForCategory(currentLang, categoryId),
]);
const categoryName =
  allCategories.find((item) => item.id === categoryId)?.name ?? categoryId;
const {
  items: posts,
  currentPage,
  totalPages,
} = paginateItems(
  categoryPosts,
  requestedPage,
  undefined,
  FEATURED_FIRST_PAGE_POSTS,
);
const sourcePath = `/${currentLang}/categories/${categoryId}/page/${currentPage}/`;
const pageTitle =
  currentLang === "zh"
    ? `${categoryName} - 第 ${currentPage} 頁`
    : `${categoryName} - Page ${currentPage}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-md focus:outline-none dark:focus:bg-gray-900 dark:focus:text-gray-100"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="mx-auto w-full max-w-3xl px-3 py-8 md:px-6">
      <CategorySelect
        currentLang={currentLang}
        categories={allCategories}
        totalCount={allPosts.length}
        activeCategory={categoryId}
      />
      <PostGrid
        posts={posts}
        currentLang={currentLang}
        sourcePath={sourcePath}
      />
      <PaginationNav
        currentLang={currentLang}
        currentPage={currentPage}
        totalPages={totalPages}
        basePath={`/${currentLang}/categories/${categoryId}`}
      />
    </main>
    <Footer />
  </body>
</html>
