---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from "../../consts";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "en" | "zh";

const labels = {
  en: {
    title: "Search",
    placeholder: "Search AI policy, Bitcoin reserve, OpenClaw...",
    hint: "Type a keyword to search this language archive.",
    loading: "Searching...",
    empty: "No matching posts found.",
    emptyTitle: "Search",
    error:
      "Search is not available yet. Run a production build to generate the Pagefind index.",
    results: "results",
    open: "Open post",
  },
  zh: {
    title: "搜尋",
    placeholder: "搜尋 AI 基本法、比特幣儲備、OpenClaw...",
    hint: "輸入關鍵字來搜尋部落格中的文章。",
    loading: "搜尋中...",
    empty: "找不到符合的文章。",
    emptyTitle: "搜尋",
    error: "搜尋索引尚未可用。請執行正式建置以產生 Pagefind index。",
    results: "筆結果",
    open: "閱讀文章",
  },
} as const;

const t = labels[currentLang];
const siteDescription =
  currentLang === "zh" ? SITE_DESCRIPTION : SITE_DESCRIPTION_EN;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <BaseHead
      title={t.title}
      description={siteDescription}
      alternateUrl={currentLang === "en" ? "/zh/search/" : "/en/search/"}
    />
  </head>
  <body class="bg-white text-gray-950 dark:bg-[#0a0a0a] dark:text-gray-50">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-md focus:outline-none dark:focus:bg-gray-900 dark:focus:text-gray-100"
    >
      Skip to main content
    </a>
    <Header />
    <main
      id="main-content"
      class="mx-auto w-full max-w-3xl px-4 py-8 md:px-6"
      data-search-root
      data-label-loading={t.loading}
      data-label-empty={t.empty}
      data-label-error={t.error}
      data-label-hint={t.hint}
      data-label-results={t.results}
      data-label-open={t.open}
    >
      <!-- Search Bar -->
      <form role="search" data-search-form class="mb-2">
        <label class="sr-only" for="site-search-input">{t.title}</label>
        <div
          transition:name="search-field"
          class="group flex items-center gap-3 rounded-xl border border-black/10 bg-gray-50 px-4 py-3 transition focus-within:border-black/30 focus-within:bg-white dark:border-white/15 dark:bg-white/5 dark:focus-within:border-white/40 dark:focus-within:bg-white/10"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5 flex-none text-gray-500 dark:text-gray-400"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="m21 21-4.2-4.2m1.2-5.3a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
          <input
            id="site-search-input"
            data-search-input
            name="q"
            type="search"
            autocomplete="off"
            class="w-full bg-transparent text-base outline-none placeholder:text-gray-400 dark:placeholder:text-gray-500"
            placeholder={t.placeholder}
          />
        </div>
      </form>

      <!-- Status Bar -->
      <div
        class="mb-2 flex items-center justify-end gap-4 pb-2 text-sm text-gray-500 empty:hidden dark:text-gray-400"
      >
        <p data-search-status></p>
      </div>

      <!-- Empty State -->
      <div
        data-search-empty-state
        class="flex flex-col items-center justify-center rounded-2xl border border-gray-200 bg-gray-50/50 py-20 text-center opacity-0 transition-opacity duration-300 dark:border-white/10 dark:bg-white/5"
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm dark:bg-white/10"
        >
          <svg
            aria-hidden="true"
            class="h-6 w-6 text-gray-400 dark:text-gray-500"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="m21 21-4.2-4.2m1.2-5.3a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <p
          class="mt-3 max-w-sm px-4 text-sm leading-6 text-gray-500 dark:text-gray-400"
        >
          {t.hint}
        </p>
      </div>

      <!-- Results -->
      <section
        class="space-y-2"
        style="display:none"
        aria-live="polite"
        data-search-results
      >
      </section>
    </main>
    <Footer />

    <script is:inline>
      const initializeSearch = () => {
        const root = document.querySelector("[data-search-root]");
        const form = document.querySelector("[data-search-form]");
        const input = document.querySelector("[data-search-input]");
        const status = document.querySelector("[data-search-status]");
        const results = document.querySelector("[data-search-results]");
        const emptyState = document.querySelector("[data-search-empty-state]");

        if (!form || !input || !status || !results || !emptyState) return;
        if (form.dataset.searchReady === "true") return;
        form.dataset.searchReady = "true";

        const labels = {
          labelHint: "Type a keyword to search",
          labelLoading: "Searching...",
          labelEmpty: "No matching posts found.",
          labelResults: "results",
          labelError: "Search unavailable",
          labelOpen: "Open",
          ...root?.dataset,
        };

        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get("q") || "";
        const shouldFocusSearch = params.has("focusSearch");
        let pagefindPromise;
        let latestSearch = 0;

        const setStatus = (message) => {
          status.textContent = message;
        };

        const clearResults = () => {
          results.replaceChildren();
        };

        const escapeHtml = (value) =>
          String(value).replace(/[&<>"']/g, (char) => {
            const entities = {
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            };
            return entities[char] || char;
          });

        const escapeRegex = (value) =>
          value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

        const getQueryTerms = (query) => {
          const trimmed = query.trim();
          if (!trimmed) return [];

          if (typeof Intl !== "undefined" && typeof Intl.Segmenter !== "undefined") {
            try {
              const segmenter = new Intl.Segmenter(document.documentElement.lang, {
                granularity: "word",
              });
              const terms = [...segmenter.segment(trimmed)]
                .filter((segment) => segment.isWordLike)
                .map((segment) => segment.segment.trim())
                .filter(Boolean);

              if (terms.length) return terms;
            } catch {}
          }

          return trimmed.split(/\s+/).filter(Boolean);
        };

        const highlightMatches = (text, query) => {
          const source = String(text || "");
          const trimmed = query.trim();

          if (!source) return "";
          if (!trimmed) return escapeHtml(source);

          const exactPhrase = source
            .toLocaleLowerCase()
            .includes(trimmed.toLocaleLowerCase())
            ? [trimmed]
            : [];
          const terms = (exactPhrase.length ? exactPhrase : getQueryTerms(trimmed))
            .map((term) => term.trim())
            .filter(Boolean)
            .filter((term, index, all) => {
              const normalized = term.toLocaleLowerCase();
              return (
                all.findIndex(
                  (candidate) => candidate.toLocaleLowerCase() === normalized,
                ) === index
              );
            })
            .filter((term) => {
              const compact = term.replace(/\s+/g, "");
              return /^[a-z0-9]+$/i.test(compact)
                ? compact.length >= 2
                : compact.length >= 1;
            })
            .sort((a, b) => b.length - a.length);

          if (!terms.length) return escapeHtml(source);

          const matcher = new RegExp(
            `(${terms.map((term) => escapeRegex(term)).join("|")})`,
            "giu",
          );

          return source
            .split(matcher)
            .map((part, index) =>
              index % 2 === 1
                ? `<mark>${escapeHtml(part)}</mark>`
                : escapeHtml(part),
            )
            .join("");
        };

        const getPlainExcerpt = (data) =>
          data.plain_excerpt || data.excerpt?.replace(/<\/?mark>/g, "") || "";

        const createResult = (data, query) => {
          const article = document.createElement("article");
          article.className =
            "group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-4 transition-all hover:border-gray-300 hover:bg-gray-50 hover:shadow-sm dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/20 dark:hover:bg-white/[0.08]";

          const link = document.createElement("a");
          link.href = data.url;
          link.className = "block";

          const title = document.createElement("h2");
          title.className =
            "pr-7 text-base font-semibold tracking-tight text-gray-950 group-hover:underline dark:text-white";
          title.innerHTML = highlightMatches(data.meta?.title || data.url, query);

          const excerpt = document.createElement("p");
          excerpt.className =
            "mt-1 line-clamp-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300";
          excerpt.innerHTML = highlightMatches(getPlainExcerpt(data), query);

          const arrow = document.createElement("span");
          arrow.className =
            "absolute top-4 right-4 text-gray-400 transition-transform group-hover:translate-x-1 dark:text-gray-500";
          arrow.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          `;

          link.append(title, excerpt);
          article.append(link, arrow);
          return article;
        };

        const getPagefind = async () => {
          pagefindPromise ||= import("/pagefind/pagefind.js");
          return pagefindPromise;
        };

        const runSearch = async (query) => {
          const trimmed = query.trim();
          const nextUrl = new URL(window.location.href);
          nextUrl.searchParams.delete("focusSearch");

          if (trimmed) {
            nextUrl.searchParams.set("q", trimmed);
          } else {
            nextUrl.searchParams.delete("q");
          }
          window.history.replaceState({}, "", nextUrl);

          if (!trimmed) {
            clearResults();
            setStatus("");
            emptyState.classList.remove("hidden");
            results.style.display = "none";
            requestAnimationFrame(() => {
              emptyState.classList.remove("opacity-0");
            });
            return;
          }

          emptyState.classList.add("opacity-0", "hidden");
          results.style.display = "";

          const searchId = ++latestSearch;
          setStatus(labels.labelLoading);

          try {
            const pagefind = await getPagefind();
            const search = await pagefind.search(trimmed);
            if (searchId !== latestSearch) return;

            clearResults();

            if (!search.results.length) {
              setStatus(labels.labelEmpty || "No results");
              return;
            }

            setStatus(
              `${search.results.length} ${labels.labelResults || "results"}`,
            );
            const fragment = document.createDocumentFragment();
            const data = await Promise.all(
              search.results.slice(0, 20).map((result) => result.data()),
            );
            for (const item of data) {
              fragment.append(createResult(item, trimmed));
            }
            results.append(fragment);
          } catch {
            clearResults();
            setStatus(labels.labelError || "Search unavailable");
          }
        };

        input.value = initialQuery;
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          runSearch(input.value);
        });
        let debounceTimer;

        const debouncedSearch = (query) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => runSearch(query), 250);
        };

        input.addEventListener("input", () => debouncedSearch(input.value));
        runSearch(initialQuery);

        if (shouldFocusSearch || !initialQuery) {
          setTimeout(() => {
            input.focus();
            input.select();
          }, 100);
        }
      };

      document.addEventListener("DOMContentLoaded", initializeSearch);
      document.addEventListener("astro:page-load", initializeSearch);
    </script>
  </body>
</html>
