---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from "../../consts";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params;
const currentLang = lang as "en" | "zh";

const labels = {
  en: {
    title: "Search",
    eyebrow: "Site search",
    heading: "Find the exact essay, note, or policy thread.",
    description:
      "Search across Ju-Chun Ko's bilingual archive of AI, technology policy, Web3, law, and legislative writing.",
    placeholder: "Search AI policy, Bitcoin reserve, OpenClaw...",
    hint: "Type a keyword to search this language archive.",
    loading: "Searching...",
    empty: "No matching posts found.",
    emptyTitle: "Search",
    emptyDescription:
      "Search across Ju-Chun Ko&apos;s bilingual archive of AI, technology policy, Web3, law, and legislative writing.",
    error:
      "Search is not available yet. Run a production build to generate the Pagefind index.",
    results: "results",
    open: "Open post",
  },
  zh: {
    title: "搜尋",
    eyebrow: "站內搜尋",
    heading: "快速找到文章、筆記與政策脈絡。",
    description:
      "搜尋寶博士部落格中關於 AI、科技政策、Web3、法律與立法院工作的雙語文章。",
    placeholder: "搜尋 AI 基本法、比特幣儲備、OpenClaw...",
    hint: "輸入關鍵字，搜尋目前語言的文章庫。",
    loading: "搜尋中...",
    empty: "找不到符合的文章。",
    emptyTitle: "搜尋",
    emptyDescription:
      "搜尋寶博士部落格中關於 AI、科技政策、Web3、法律與立法院工作的雙語文章。",
    error: "搜尋索引尚未可用。請執行正式建置以產生 Pagefind index。",
    results: "筆結果",
    open: "閱讀文章",
  },
} as const;

const t = labels[currentLang];
const siteDescription =
  currentLang === "zh" ? SITE_DESCRIPTION : SITE_DESCRIPTION_EN;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <BaseHead
      title={t.title}
      description={t.description || siteDescription}
      alternateUrl={currentLang === "en" ? "/zh/search/" : "/en/search/"}
    />
  </head>
  <body class="bg-white text-gray-950 dark:bg-black dark:text-gray-50">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-md focus:outline-none dark:focus:bg-gray-900 dark:focus:text-gray-100"
    >
      Skip to main content
    </a>
    <Header />
    <main
      id="main-content"
      class="mx-auto w-full max-w-5xl px-4 py-10 md:px-6 md:py-14"
      data-search-root
      data-label-loading={t.loading}
      data-label-empty={t.empty}
      data-label-error={t.error}
      data-label-hint={t.hint}
      data-label-results={t.results}
      data-label-open={t.open}
    >
      <form role="search" data-search-form>
        <label class="sr-only" for="site-search-input">{t.title}</label>
        <div
          transition:name="search-field"
          class="group flex items-center gap-3 rounded-xl border border-black/10 bg-gray-50 px-4 py-3 transition focus-within:border-black/30 focus-within:bg-white dark:border-white/15 dark:bg-white/5 dark:focus-within:border-white/40 dark:focus-within:bg-white/10"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5 flex-none text-gray-500 dark:text-gray-400"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="m21 21-4.2-4.2m1.2-5.3a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
          <input
            id="site-search-input"
            data-search-input
            name="q"
            type="search"
            autocomplete="off"
            class="w-full bg-transparent text-lg outline-none placeholder:text-gray-400 dark:placeholder:text-gray-500"
            placeholder={t.placeholder}
          />
        </div>
      </form>

      <div
        class="mt-5 flex items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400"
      >
        <p data-search-status></p>
      </div>

      <div
        data-search-empty-state
        class="my-20 flex flex-col items-center justify-center text-center opacity-0 transition-opacity duration-300"
      >
        <div
          class="flex h-20 w-20 items-center justify-center rounded-full bg-gray-50 dark:bg-white/5"
        >
          <svg
            aria-hidden="true"
            class="h-10 w-10 text-gray-400 dark:text-gray-500"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="m21 21-4.2-4.2m1.2-5.3a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h2 class="mt-6 text-xl font-semibold text-gray-900 dark:text-gray-100">
          {t.emptyTitle}
        </h2>
        <p
          class="mt-3 max-w-md text-sm leading-6 text-gray-500 dark:text-gray-400"
        >
          {t.emptyDescription}
        </p>
      </div>

      <section
        class="mt-8 grid grid-cols-1 gap-4"
        style="display:none"
        aria-live="polite"
        data-search-results
      >
      </section>
    </main>
    <Footer />

    <script is:inline>
      const initializeSearch = () => {
        const root = document.querySelector("[data-search-root]");
        const form = document.querySelector("[data-search-form]");
        const input = document.querySelector("[data-search-input]");
        const status = document.querySelector("[data-search-status]");
        const results = document.querySelector("[data-search-results]");
        const emptyState = document.querySelector("[data-search-empty-state]");

        if (!form || !input || !status || !results || !emptyState) return;
        if (form.dataset.searchReady === "true") return;
        form.dataset.searchReady = "true";

        const labels = {
          labelHint: "Type a keyword to search",
          labelLoading: "Searching...",
          labelEmpty: "No matching posts found.",
          labelResults: "results",
          labelError: "Search unavailable",
          labelOpen: "Open",
          ...root?.dataset,
        };

        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get("q") || "";
        const shouldFocusSearch = params.has("focusSearch");
        let pagefindPromise;
        let latestSearch = 0;

        const setStatus = (message) => {
          status.textContent = message;
        };

        const clearResults = () => {
          results.replaceChildren();
        };

        const createResult = (data) => {
          const article = document.createElement("article");
          article.className =
            "group rounded-xl border border-black/10 bg-white p-5 transition hover:bg-gray-50 hover:border-black/20 dark:border-white/10 dark:bg-zinc-950 dark:hover:bg-white/5 dark:hover:border-white/20";

          const link = document.createElement("a");
          link.href = data.url;
          link.className = "block";

          const title = document.createElement("h2");
          title.className =
            "text-xl font-semibold tracking-[-0.02em] text-gray-950 group-hover:underline dark:text-white";
          title.textContent = data.meta?.title || data.url;

          const excerpt = document.createElement("p");
          excerpt.className =
            "mt-3 line-clamp-3 text-sm leading-6 text-gray-600 dark:text-gray-300";
          excerpt.innerHTML = data.excerpt || "";

          link.append(title, excerpt);
          article.append(link);
          return article;
        };

        const getPagefind = async () => {
          pagefindPromise ||= import("/pagefind/pagefind.js");
          return pagefindPromise;
        };

        const runSearch = async (query) => {
          const trimmed = query.trim();
          const nextUrl = new URL(window.location.href);
          nextUrl.searchParams.delete("focusSearch");

          if (trimmed) {
            nextUrl.searchParams.set("q", trimmed);
          } else {
            nextUrl.searchParams.delete("q");
          }
          window.history.replaceState({}, "", nextUrl);

          clearResults();
          if (!trimmed) {
            setStatus("");
            emptyState.classList.remove("hidden");
            results.style.display = "none";
            // Add a small delay for the fade-in effect to work
            requestAnimationFrame(() => {
              emptyState.classList.remove("opacity-0");
            });
            return;
          }

          emptyState.classList.add("opacity-0", "hidden");
          results.style.display = "";

          const searchId = ++latestSearch;
          setStatus(labels.labelLoading);

          try {
            const pagefind = await getPagefind();
            const search = await pagefind.search(trimmed);
            if (searchId !== latestSearch) return;

            if (!search.results.length) {
              setStatus(labels.labelEmpty || "No results");
              return;
            }

            setStatus(
              `${search.results.length} ${labels.labelResults || "results"}`,
            );
            const fragment = document.createDocumentFragment();
            const data = await Promise.all(
              search.results.slice(0, 20).map((result) => result.data()),
            );
            for (const item of data) {
              fragment.append(createResult(item));
            }
            results.append(fragment);
          } catch {
            setStatus(labels.labelError || "Search unavailable");
          }
        };

        input.value = initialQuery;
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          runSearch(input.value);
        });
        input.addEventListener("input", () => runSearch(input.value));
        runSearch(initialQuery);

        if (shouldFocusSearch || !initialQuery) {
          // Focus after view transition completes
          setTimeout(() => {
            input.focus();
            input.select();
          }, 100);
        }
      };

      document.addEventListener("DOMContentLoaded", initializeSearch);
      document.addEventListener("astro:page-load", initializeSearch);
    </script>
  </body>
</html>
