---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategorySelect from "../../components/CategorySelect.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import PostGrid from "../../components/PostGrid.astro";
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from "../../consts";
import {
  FEATURED_FIRST_PAGE_POSTS,
  getCategorySummaries,
  getPostsForLang,
  paginateItems,
} from "../../lib/blog";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params;

// Ensure TypeScript knows the exact union type for language
const currentLang = lang as "en" | "zh";
const allPosts = await getPostsForLang(currentLang);
const categories = await getCategorySummaries(currentLang);
const {
  items: posts,
  currentPage,
  totalPages,
} = paginateItems(allPosts, 1, undefined, FEATURED_FIRST_PAGE_POSTS);
const sourcePath = `/${currentLang}/`;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const siteTitle = currentLang === "zh" ? "科技立委葛如鈞寶博士部落格" : "JU CHUN KO's Blog";
const siteDescription = currentLang === "zh" ? SITE_DESCRIPTION : SITE_DESCRIPTION_EN;
const siteKeywords =
  currentLang === "zh"
    ? ["葛如鈞", "寶博士", "立法委員", "AI", "人工智慧", "科技政策", "區塊鏈", "Web3", "核能", "部落格"]
    : ["Ju-Chun Ko", "JC Ko", "legislator", "AI", "technology policy", "blockchain", "Taiwan", "blog"];

// Blog listing page schema for GEO
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${siteUrl}/${currentLang}/`,
  name: siteTitle,
  description: siteDescription,
  url: `${siteUrl}/${currentLang}/`,
  inLanguage: currentLang === "zh" ? "zh-TW" : "en",
  author: {
    "@type": "Person",
    name: currentLang === "zh" ? "葛如鈞" : "Dr. Ju-Chun Ko",
    url: `${siteUrl}/${currentLang}/authors/juchun-ko`,
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      description={siteDescription}
      keywords={siteKeywords}
      alternateUrl={currentLang === "en" ? "/zh" : "/en"}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-md focus:outline-none dark:focus:bg-gray-900 dark:focus:text-gray-100"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="mx-auto w-full max-w-3xl px-3 py-8 md:px-6">
      <CategorySelect
        currentLang={currentLang}
        categories={categories}
        totalCount={allPosts.length}
      />
      <PostGrid
        posts={posts}
        currentLang={currentLang}
        featuredCount={1}
        sourcePath={sourcePath}
      />
      <PaginationNav
        currentLang={currentLang}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </main>
    <Footer />
  </body>
</html>
