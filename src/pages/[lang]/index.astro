---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import PostGrid from "../../components/PostGrid.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getPostsForLang, paginateItems } from "../../lib/blog";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params;

// Ensure TypeScript knows the exact union type for language
const currentLang = lang as "en" | "zh";
const allPosts = await getPostsForLang(currentLang);
const { items: posts, currentPage, totalPages } = paginateItems(allPosts, 1);
const sourcePath = `/${currentLang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="mx-auto w-full max-w-7xl px-4 py-8 md:px-6">
      <PostGrid
        posts={posts}
        currentLang={currentLang}
        featuredCount={2}
        sourcePath={sourcePath}
      />
      <PaginationNav
        currentLang={currentLang}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </main>
    <Footer />
  </body>
</html>
