---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { languages } from "../../../i18n/ui";
import type { GetStaticPaths } from "astro";
import SocialIcon from "../../../components/SocialIcon.astro";
import { useTranslations } from "../../../i18n/utils";
import PostGrid from "../../../components/PostGrid.astro";

type Language = keyof typeof languages;

export const getStaticPaths = (async () => {
  const authors = await getCollection("authors");
  return authors.flatMap((author) =>
    (Object.keys(languages) as Language[]).map((lang) => ({
      params: { lang, slug: author.id },
      props: { author },
    })),
  );
}) satisfies GetStaticPaths;

const { author } = Astro.props;
const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const allPosts = await getCollection("blog");

const posts = allPosts
  .filter(
    (post) =>
      post.data.author.some((a) => a.id === author.id) &&
      post.id.startsWith(`${lang}/`),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const authorName = author.data.name[lang];
const authorBio = author.data.bio[lang];
const socialLinks = author.data.social;
const pageTitle = `${authorName} | Author`;
const pageDescription = authorBio;

// Build Person JSON-LD for GEO / AI citation
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const sameAs: string[] = [];
// Always include the blog and transpal as sameAs for this author
sameAs.push(`${siteUrl}/${lang}/authors/${author.id}`);
sameAs.push("https://transpal.juchunko.com");
if (socialLinks?.twitter) sameAs.push(socialLinks.twitter);
if (socialLinks?.facebook) sameAs.push(socialLinks.facebook);
if (socialLinks?.youtube) sameAs.push(socialLinks.youtube);
if (socialLinks?.github) sameAs.push(socialLinks.github);
if (socialLinks?.instagram) sameAs.push(socialLinks.instagram);
if (socialLinks?.threads) sameAs.push(socialLinks.threads);
if (socialLinks?.website) sameAs.push(socialLinks.website);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: authorName,
  description: authorBio,
  url: socialLinks?.website ?? `${siteUrl}/${lang}/authors/${author.id}`,
  image: author.data.avatar ? `${siteUrl}${author.data.avatar}` : undefined,
  ...(socialLinks?.email ? { email: `mailto:${socialLinks.email}` } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  
  <div class="space-y-12">
    <!-- Author profile card -->
    <div
      class="rounded-2xl border border-black/10 bg-gray-50/50 p-6 dark:border-white/15 dark:bg-zinc-900/50 backdrop-blur-md flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8 transition-colors"
    >
      {author.data.avatar && (
        <img
          src={author.data.avatar}
          width={120}
          height={120}
          alt={authorName}
          class="aspect-square rounded-full object-cover border border-black/5 dark:border-white/10"
        />
      )}
      <div class="flex-1 flex flex-col items-center md:items-start text-center md:text-left gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50">
          {authorName}
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
          {authorBio}
        </p>
        {
          socialLinks && (
            <div class="mt-2 flex flex-wrap justify-center md:justify-start gap-3">
              {Object.entries(socialLinks).map(([name, url]) => (
                <a
                  href={name === "email" ? `mailto:${url}` : url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-black/10 text-gray-600 transition hover:border-black/20 hover:bg-gray-100 hover:text-gray-900 dark:border-white/15 dark:text-gray-300 dark:hover:border-white/25 dark:hover:bg-white/10 dark:hover:text-white"
                  title={t(`social.${name}` as "social.email")}
                >
                  <span class="sr-only">
                    {t(`social.${name}` as "social.email")}
                  </span>
                  <SocialIcon name={name} />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <!-- Posts section -->
    <div class="space-y-6">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-50 flex items-center gap-2">
        <span>{t("author.postsBy").replace("{authorName}", authorName)}</span>
        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-400">
          {posts.length}
        </span>
      </h2>
      <PostGrid posts={posts} currentLang={lang} />
    </div>
  </div>
</BaseLayout>
