---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { useTranslations, getLangFromUrl } from "../i18n/utils";
import ChatBot from "../components/ChatBot";
import TTSPlayer from "../components/agent/TTSPlayer";

type Props = { post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  author,
  categories,
} = post.data;
// Fetch full author entries (author is now always an array)
const authorEntries = await Promise.all(author.map((a) => getEntry(a)));

// Fetch full category entries if any are referenced in the frontmatter
const categoryEntries = categories
  ? await Promise.all(categories.map((cat) => getEntry(cat)))
  : [];

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const slugWithLang = post.id.replace(/\.(md|mdx)$/, "");
const [, ...rest] = slugWithLang.split("/");
const slug = rest.join("/");
const otherLang = currentLang === "en" ? "zh" : "en";

const posts = await getCollection("blog");
const otherLangPost = posts.find(
  (p) => p.id.replace(/\.(md|mdx)$/, "") === `${otherLang}/${slug}`,
);
const sameLangPosts = posts
  .filter((entry) => entry.id.startsWith(`${currentLang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sameLangPosts.findIndex((entry) => entry.id === post.id);
const nextPost =
  currentIndex >= 0 && currentIndex < sameLangPosts.length - 1
    ? sameLangPosts[currentIndex + 1]
    : undefined;

const navLabels = {
  en: {
    back: "Back",
    next: "Next post",
  },
  zh: {
    back: "回前頁",
    next: "下一篇",
  },
} as const;

const navText = navLabels[currentLang];
const backFallbackUrl = `/${currentLang}/`;

// Detect math content to conditionally load KaTeX CSS
const hasKatex =
  post.body?.includes("$$") || post.body?.includes("\\[");

// JSON-LD structured data
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const pageUrl = Astro.url.href;
const imageUrl = heroImage
  ? heroImage.startsWith("http")
    ? heroImage
    : `${siteUrl}${heroImage}`
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: authorEntries
    .filter(Boolean)
    .map((authorData) => ({
      "@type": "Person",
      name: authorData!.data.name[currentLang],
      url: `${siteUrl}/${currentLang}/authors/${authorData!.id}`,
    })),
  ...(imageUrl ? { image: imageUrl } : {}),
  url: pageUrl,
  inLanguage: currentLang,
};
---

<html lang={currentLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      alternateUrl={otherLangPost
        ? `/${otherLangPost.id.replace(/\.(md|mdx)$/, "")}`
        : undefined}
      ogType="article"
      publishedTime={pubDate}
      authors={authorEntries
        .filter((a) => a != null)
        .map((a) => a.data.name[currentLang])}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      hasKatex && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
          integrity="sha384-5TcZemv2l/9On385z///+d7MSYlvIxqAVtrAFnx9ZfDnh1X04cYo0v8RBU3ZFgGK"
          crossorigin="anonymous"
        />
      )
    }
    <style>
      .lang-switcher {
        text-align: center;
        margin-bottom: 1rem;
      }
    </style>
    <script is:inline>
      const bindPostNavLinks = () => {
        const backLink = document.getElementById("post-back-link");
        if (!(backLink instanceof HTMLAnchorElement)) return;

        const params = new URLSearchParams(window.location.search);
        const fromParam = params.get("from");

        if (fromParam && fromParam.startsWith("/")) {
          backLink.href = fromParam;
        } else {
          try {
            const referrer = document.referrer ? new URL(document.referrer) : null;
            const isSameOrigin = referrer && referrer.origin === window.location.origin;

            if (isSameOrigin) {
              backLink.href = `${referrer.pathname}${referrer.search}${referrer.hash}`;
            }
          } catch {}
        }

        const nextLink = document.getElementById("post-next-link");
        if (nextLink instanceof HTMLAnchorElement) {
          const nextPath = nextLink.dataset.nextPath;
          if (nextPath) {
            const currentUrl = `${window.location.pathname}${window.location.search}`;
            nextLink.href = `${nextPath}?from=${encodeURIComponent(currentUrl)}`;
          }
        }
      };

      document.addEventListener("DOMContentLoaded", bindPostNavLinks);
      document.addEventListener("astro:page-load", bindPostNavLinks);
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-md focus:outline-none dark:focus:bg-gray-900 dark:focus:text-gray-100"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content">
      <article>
        <div class="container mb-4">
          <div class="flex items-center justify-between gap-3">
            <a
              id="post-back-link"
              href={backFallbackUrl}
              class="inline-flex items-center rounded-full border border-black/10 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 dark:border-white/15 dark:text-white/80 dark:hover:bg-white/10"
            >
              ← {navText.back}
            </a>
            {
              nextPost && (
                <a
                  id="post-next-link"
                  data-next-path={`/${nextPost.id.replace(/\.(md|mdx)$/, "")}`}
                  href={`/${nextPost.id.replace(/\.(md|mdx)$/, "")}`}
                  class="inline-flex max-w-[65%] items-center justify-end rounded-full border border-black/10 px-4 py-2 text-right text-sm font-medium text-gray-700 transition hover:bg-gray-100 dark:border-white/15 dark:text-white/80 dark:hover:bg-white/10"
                >
                  <span class="truncate">
                    {navText.next} →
                  </span>
                </a>
              )
            }
          </div>
        </div>
        <div class="container">
          {
            heroImage && (
              <img
                class="w-full rounded-lg"
                src={heroImage}
                alt={heroImageAlt || title}
                transition:name={`${post.id}-image`}
              />
            )
          }
        </div>
        <div class="container">
          <div class="my-4 flex flex-col gap-4">
            {
              categoryEntries.length > 0 && (
                <ul class="-mb-2 flex flex-wrap gap-2">
                  {categoryEntries.map((cat) => (
                    <li transition:name={`${post.id}-category-${cat.id}`}>
                      <a
                        href={`/${currentLang}/categories/${cat.id}`}
                        class="rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
                      >
                        {cat.data.name[currentLang]}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
            <h1
              class="text-2xl font-semibold md:text-4xl"
              transition:name={`${post.id}-title`}
            >
              {title}
            </h1>
            {
              authorEntries.length > 0 && (
                <div class="flex flex-wrap items-center gap-4">
                  {authorEntries.map(
                    (authorData) =>
                      authorData && (
                        <a
                          href={`/${currentLang}/authors/${authorData.id}`}
                          class="flex items-center gap-2"
                        >
                          <img
                            src={authorData.data.avatar}
                            width={40}
                            height={40}
                            alt={authorData.data.name[currentLang]}
                            loading="lazy"
                            class="aspect-square rounded-full object-cover"
                          />
                          <span class="text-base font-semibold">
                            {authorData.data.name[currentLang]}
                          </span>
                        </a>
                      ),
                  )}
                </div>
              )
            }
            <div class="text-sm text-gray-500 dark:text-white/50">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="italic">
                    {t("blog.lastUpdatedOn")}{" "}
                    <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
          </div>
        </div>
        <div class="container">
          <div class="prose dark:prose-invert">
            <TTSPlayer client:load isOpen={true} lang={currentLang} />
            <hr />
            {
              otherLangPost && (
                <div class="flex justify-center">
                  <a
                    href={`/${otherLangPost.id.replace(/\.(md|mdx)$/, "")}`}
                    class="text-sm text-gray-500"
                  >
                    {t("blog.readIn").replace(
                      "{lang}",
                      otherLang === "en" ? "English" : "中文",
                    )}
                  </a>
                </div>
              )
            }
            <slot />
          </div>
        </div>
      </article>
    </main>
    <ChatBot client:only="react" />
    <Footer />
  </body>
</html>
