---
interface Props {
  currentLang: "en" | "zh";
  currentPage: number;
  totalPages: number;
}

const { currentLang, currentPage, totalPages } = Astro.props;
const previousPage = currentPage - 1;
const nextPage = currentPage + 1;
const pageHref = (page: number) =>
  page === 1 ? `/${currentLang}/` : `/${currentLang}/page/${page}/`;
const labels = {
  en: {
    previous: "Previous",
    next: "Next",
    page: "Page",
    of: "of",
  },
  zh: {
    previous: "上一頁",
    next: "下一頁",
    page: "第",
    of: "頁 / 共",
  },
}[currentLang];
const buttonClass =
  "inline-flex size-10 items-center justify-center rounded-full border border-gray-200 text-gray-700 transition hover:border-gray-300 hover:bg-gray-100 dark:border-gray-800 dark:text-gray-200 dark:hover:border-gray-700 dark:hover:bg-gray-900";
const placeholderClass = `${buttonClass} invisible`;

const visiblePageCount = 5;
const firstVisiblePage = Math.max(
  1,
  Math.min(
    currentPage - Math.floor(visiblePageCount / 2),
    totalPages - visiblePageCount + 1,
  ),
);
const lastVisiblePage = Math.min(
  totalPages,
  firstVisiblePage + visiblePageCount - 1,
);
const pageNumbers = Array.from(
  { length: lastVisiblePage - firstVisiblePage + 1 },
  (_, index) => firstVisiblePage + index,
);
---

{
  totalPages > 1 && (
    <nav
      class="mt-10 grid grid-cols-[auto_1fr_auto] items-center gap-3 border-t border-gray-200 pt-5 text-sm md:mt-12 md:gap-4 md:pt-6 dark:border-gray-800"
      aria-label="Pagination"
    >
      {currentPage > 1 ? (
        <a
          href={pageHref(previousPage)}
          class={buttonClass}
          aria-label={labels.previous}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="size-5"
            fill="none"
          >
            <path
              d="M12 5 7 10l5 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ) : (
        <span class={placeholderClass} aria-hidden="true" />
      )}
      <div class="flex min-w-0 items-center justify-center gap-1">
        {pageNumbers.map((page) =>
          page === currentPage ? (
            <span
              class="inline-flex h-9 min-w-9 items-center justify-center rounded-full bg-gray-900 px-3 font-semibold text-white dark:bg-gray-100 dark:text-gray-950"
              aria-current="page"
            >
              {page}
            </span>
          ) : (
            <a
              href={pageHref(page)}
              class="inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 font-medium text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-gray-100"
              aria-label={`${labels.page} ${page}`}
            >
              {page}
            </a>
          ),
        )}
      </div>
      {currentPage < totalPages ? (
        <a
          href={pageHref(nextPage)}
          class={buttonClass}
          aria-label={labels.next}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            class="size-5"
            fill="none"
          >
            <path
              d="m8 5 5 5-5 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ) : (
        <span class={placeholderClass} aria-hidden="true" />
      )}
    </nav>
  )
}
