---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description: string;
  image?: string;
  alternateUrl?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  authors?: string[];
  keywords?: string[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const siteTitle = t("site.title");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title: pageTitle,
  description,
  image = "/images/avatar.webp",
  alternateUrl,
  ogType = "website",
  publishedTime,
  authors,
  keywords,
} = Astro.props;

const title = pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle;

// Build hreflang URLs
const currentFullUrl = new URL(Astro.url.pathname, Astro.site).href;
const alternateFullUrl = alternateUrl
  ? new URL(alternateUrl, Astro.site).href
  : undefined;

const enUrl = lang === "en" ? currentFullUrl : alternateFullUrl;
const zhUrl = lang === "zh" ? currentFullUrl : alternateFullUrl;
const xDefaultUrl = enUrl ?? currentFullUrl;

// og:locale mapping
const ogLocale = lang === "zh" ? "zh_TW" : "en_US";
const ogLocaleAlternate = lang === "zh" ? "en_US" : "zh_TW";

// Site-level WebSite schema for GEO / AI citation
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: siteUrl,
  description: description,
  inLanguage: lang === "zh" ? "zh-TW" : "en",
  sameAs: [
    "https://juchunko.com",
    "https://transpal.juchunko.com",
  ],
  author: {
    "@type": "Person",
    name: lang === "zh" ? "葛如鈞" : "Dr. Ju-Chun Ko",
    url: "https://juchunko.com",
    jobTitle: lang === "zh" ? "立法委員" : "Legislator",
    affiliation: {
      "@type": "Organization",
      name: lang === "zh" ? "中華民國立法院" : "Legislative Yuan of the Republic of China (Taiwan)",
    },
    sameAs: [
      "https://juchunko.com",
      "https://blog.juchunko.com",
      "https://transpal.juchunko.com",
      "https://x.com/dAAAb",
      "https://fb.com/dr.juchunko/",
      "https://youtube.com/@dr.juchunko",
      "https://github.com/DrJuChunKo",
      "https://instagr.am/dr.juchunko/",
      "https://threads.net/@dr.juchunko",
    ],
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/${lang}/search/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Font -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Noto+Sans+TC:wght@100..900&display=swap"
  rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternate links -->
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{zhUrl && <link rel="alternate" hreflang="zh" href={zhUrl} />}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{authors && authors.length > 0 && <meta name="author" content={authors.join(", ")} />}
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:site_name" content={siteTitle} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{ogType === "article" && authors && authors.map((author) => (
  <meta property="article:author" content={author} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />
<meta property="twitter:site" content="@dAAAb" />
<meta property="twitter:creator" content="@dAAAb" />

<!-- WebSite Schema (GEO / AI citation) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

<!-- Google tag (gtag.js) -->
<script
  is:inline
  type="text/partytown"
  src="https://www.googletagmanager.com/gtag/js?id=G-8CV1BWFW7T"></script>
<script is:inline type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-8CV1BWFW7T");
</script>

<ClientRouter />
