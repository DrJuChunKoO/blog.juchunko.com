---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description: string;
  image?: string;
  alternateUrl?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  authors?: string[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const siteTitle = t("site.title");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title: pageTitle,
  description,
  image = "/images/avatar.webp",
  alternateUrl,
  ogType = "website",
  publishedTime,
  authors,
} = Astro.props;

const title = pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle;

// Build hreflang URLs
const currentFullUrl = new URL(Astro.url.pathname, Astro.site).href;
const alternateFullUrl = alternateUrl
  ? new URL(alternateUrl, Astro.site).href
  : undefined;

const enUrl = lang === "en" ? currentFullUrl : alternateFullUrl;
const zhUrl = lang === "zh" ? currentFullUrl : alternateFullUrl;
const xDefaultUrl = enUrl ?? currentFullUrl;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Noto+Sans+TC:wght@100..900&display=swap"
  rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternate links -->
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{zhUrl && <link rel="alternate" hreflang="zh" href={zhUrl} />}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{ogType === "article" && authors && authors.map((author) => (
  <meta property="article:author" content={author} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />

<!-- Google tag (gtag.js) -->
<script
  is:inline
  type="text/partytown"
  src="https://www.googletagmanager.com/gtag/js?id=G-8CV1BWFW7T"></script>
<script is:inline type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-8CV1BWFW7T");
</script>

<ClientRouter />
