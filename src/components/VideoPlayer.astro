---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const labels = {
  play: t("video.play"),
  pause: t("video.pause"),
  mute: t("video.mute"),
  unmute: t("video.unmute"),
  fullscreen: t("video.fullscreen"),
  exitFullscreen: t("video.exitFullscreen"),
  loading: t("video.loading"),
  error: t("video.error"),
  playError: t("video.playError"),
  fullscreenError: t("video.fullscreenError"),
  of: t("video.of"),
};
---

<template id="video-player-template">
  <div
    class="video-player not-prose tts-ignore"
    role="group"
    aria-label={t("video.player")}
    data-pagefind-ignore
    data-labels={JSON.stringify(labels)}
    data-state="paused"
  >
    <div class="video-player__stage">
      <div class="video-player__notice" hidden>
        <span role="status" data-status></span>
        <button type="button" data-retry hidden>{t("video.retry")}</button>
      </div>
      <button
        class="video-player__center-play"
        type="button"
        data-play
        aria-label={t("video.play")}
        title={t("video.play")}
      >
        <svg
          class="video-player__play-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="m7 4 13 8-13 8Z" fill="currentColor" stroke="none"
          ></path></svg
        >
        <svg
          class="video-player__pause-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="M9 5v14M15 5v14" stroke-width="2.5"></path></svg
        >
      </button>
      <div class="video-player__controls">
        <div class="video-player__toolbar">
          <button
            class="video-player__button"
            type="button"
            data-play
            aria-label={t("video.play")}
            title={t("video.play")}
          >
            <svg
              class="video-player__play-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path d="m7 4 13 8-13 8Z" fill="currentColor" stroke="none"
              ></path></svg
            >
            <svg
              class="video-player__pause-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path d="M9 5v14M15 5v14" stroke-width="2.5"></path></svg
            >
          </button>
          <span class="video-player__time"
            ><span data-elapsed>00:00</span> / <span data-duration>--:--</span
            ></span
          >
          <input
            class="video-player__seek"
            type="range"
            min="0"
            max="0"
            step="0.1"
            value="0"
            aria-label={t("video.seek")}
            disabled
          />
          <details class="video-player__settings">
            <summary
              class="video-player__button"
              aria-label={t("video.settings")}
              title={t("video.settings")}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="3"
                ></path></svg
              >
            </summary>
            <div class="video-player__panel">
              <div class="video-player__sound">
                <button
                  class="video-player__button"
                  type="button"
                  data-mute
                  aria-label={t("video.mute")}
                  title={t("video.mute")}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m11 5-6 4H2v6h3l6 4Z"></path>
                    <path
                      class="video-player__sound-on"
                      d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"></path>
                    <path class="video-player__sound-off" d="m16 9 6 6m0-6-6 6"
                    ></path>
                  </svg>
                </button>
                <span class="video-player__volume-label"
                  >{t("video.volume")}</span
                >
                <input
                  class="video-player__volume"
                  type="range"
                  min="0"
                  max="1"
                  step="0.05"
                  value="1"
                  aria-label={t("video.volume")}
                />
              </div>
              <label class="video-player__setting-row">
                <span>{t("video.speed")}</span>
                <select class="video-player__speed">
                  {
                    [0.5, 0.75, 1, 1.25, 1.5, 2].map((rate) => (
                      <option value={rate} selected={rate === 1}>
                        {rate}x
                      </option>
                    ))
                  }
                </select>
              </label>
              <button
                class="video-player__setting-row"
                type="button"
                data-fullscreen
                aria-label={t("video.fullscreen")}
                hidden
              >
                <span data-fullscreen-label>{t("video.fullscreen")}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"></path></svg
                >
              </button>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  import "../scripts/video-player";
</script>

<style is:global>
  .video-player {
    --vp-ink: #18181b;
    --vp-surface: #fff;
    --vp-glass: rgb(255 255 255 / 70%);
    --vp-material: var(--vp-surface);
    --vp-center-material: #333336;
    --vp-blur: 24px;
    --vp-line: rgb(0 0 0 / 10%);
    --vp-hover: rgb(0 0 0 / 6%);
    --vp-controls-fade: 150ms;
    position: relative;
    width: 100%;
    min-width: min(100%, 320px);
    max-width: min(
      var(--video-max-width, 100%),
      calc(70vh * var(--video-ratio, 1.777778))
    );
    margin: 1.5rem auto;
    border-radius: 16px;
    color: var(--vp-ink);
    font: 500 13px/1.4 var(--font-sans);
    color-scheme: light;
  }
  .dark .video-player {
    --vp-ink: #fafafa;
    --vp-surface: #18181b;
    --vp-glass: rgb(28 28 30 / 65%);
    --vp-line: rgb(255 255 255 / 15%);
    --vp-hover: rgb(255 255 255 / 10%);
    color-scheme: dark;
  }
  .video-player [hidden] {
    display: none !important;
  }
  .video-player:has(details[open]) {
    z-index: 1;
  }
  .video-player__stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--video-ratio, 1.777778);
    max-height: 70vh;
    border-radius: inherit;
    background: #09090b;
  }
  .video-player .video-player__stage video {
    display: block;
    width: 100% !important;
    height: 100%;
    max-width: none !important;
    max-height: 100%;
    margin: 0 !important;
    border-radius: inherit !important;
    object-fit: contain;
  }
  .video-player svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .video-player :is(button, select, summary) {
    cursor: pointer;
    touch-action: manipulation;
  }
  .video-player__center-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    margin: auto;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 50%;
    background: var(--vp-center-material);
    color: #fff;
    -webkit-backdrop-filter: blur(var(--vp-blur)) saturate(140%);
    backdrop-filter: blur(var(--vp-blur)) saturate(140%);
    transition:
      opacity var(--vp-controls-fade) ease-out,
      transform 150ms ease-out;
  }
  .video-player__center-play svg {
    width: 40px;
    height: 40px;
  }
  .video-player__center-play .video-player__play-icon {
    margin-left: 3px;
  }
  .video-player__center-play:active {
    transform: scale(0.94);
  }
  .video-player__center-play:focus-visible {
    outline-color: white !important;
    outline-offset: 5px !important;
  }
  .video-player__controls {
    position: absolute;
    isolation: isolate;
    inset-inline: 0;
    bottom: 0;
    padding: 2px 12px;
    border-radius: 0 0 16px 16px;
    transition: opacity var(--vp-controls-fade) ease-out;
  }
  .video-player__toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* A separate material layer lets the settings panel blur the video, too. */
  .video-player__controls::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-top: 1px solid var(--vp-line);
    border-radius: inherit;
    background: var(--vp-material);
    -webkit-backdrop-filter: blur(var(--vp-blur)) saturate(140%);
    backdrop-filter: blur(var(--vp-blur)) saturate(140%);
    pointer-events: none;
  }
  .video-player__button {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--vp-ink);
    background: transparent;
  }
  .video-player__button:hover,
  .video-player__speed:hover,
  button.video-player__setting-row:hover {
    background: var(--vp-hover);
  }
  .video-player__time {
    white-space: nowrap;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .video-player__settings {
    position: relative;
    flex: 0 0 44px;
    margin-left: auto;
  }
  .video-player__settings summary {
    list-style: none;
  }
  .video-player__settings summary::-webkit-details-marker {
    display: none;
  }
  .video-player__settings[open] summary {
    background: var(--vp-hover);
  }
  .video-player__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    width: 220px;
    padding: 8px;
    border: 1px solid var(--vp-line);
    border-radius: 20px;
    background: var(--vp-material);
    -webkit-backdrop-filter: blur(var(--vp-blur)) saturate(140%);
    backdrop-filter: blur(var(--vp-blur)) saturate(140%);
  }
  .video-player__sound,
  .video-player__setting-row {
    display: flex;
    width: 100%;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-radius: 6px;
    color: var(--vp-ink);
  }
  .video-player__setting-row {
    padding: 0 12px;
  }
  .video-player__sound {
    padding-right: 12px;
  }
  .video-player__volume-label {
    display: none;
  }
  .video-player__speed {
    width: 64px;
    height: 44px;
    padding: 0 6px;
    border-radius: 6px;
    background: transparent;
    color: var(--vp-ink);
    font: inherit;
    font-variant-numeric: tabular-nums;
  }
  .video-player input[type="range"] {
    --progress: 0%;
    display: block;
    height: 44px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
    accent-color: var(--vp-ink);
  }
  .video-player .video-player__seek {
    flex: 1;
    height: 44px;
    min-width: 24px;
    width: 0;
  }
  .video-player__volume {
    flex: 1;
    min-width: 0;
  }
  .video-player input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(
      to right,
      var(--vp-ink) var(--progress),
      var(--vp-line) var(--progress)
    );
  }
  .video-player input[type="range"]::-moz-range-track {
    height: 4px;
    border-radius: 4px;
    background: var(--vp-line);
  }
  .video-player input[type="range"]::-moz-range-progress {
    height: 4px;
    border-radius: 4px;
    background: var(--vp-ink);
  }
  .video-player input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--vp-ink);
  }
  .video-player input[type="range"]::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--vp-ink);
  }
  .video-player__seek::-webkit-slider-thumb {
    opacity: 0;
  }
  .video-player__seek::-moz-range-thumb {
    opacity: 0;
  }
  .video-player__seek:is(:hover, :focus-visible)::-webkit-slider-thumb {
    opacity: 1;
  }
  .video-player__seek:is(:hover, :focus-visible)::-moz-range-thumb {
    opacity: 1;
  }
  .video-player :is(button, summary, select, input):focus-visible {
    outline: 2px solid var(--vp-ink);
    outline-offset: 2px;
  }
  .video-player input:disabled {
    cursor: default;
    opacity: 0.35;
  }
  .video-player__notice {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    padding: 6px 12px;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 8px;
    background: rgb(9 9 11 / 85%);
    color: #fff;
    font-size: 13px;
    text-align: center;
  }
  .video-player__notice button {
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .video-player__notice button:focus-visible {
    outline-color: white;
  }
  .video-player__pause-icon,
  .video-player__sound-off {
    display: none;
  }
  .video-player[data-state="playing"] .video-player__pause-icon {
    display: block;
  }
  .video-player[data-state="playing"] .video-player__play-icon {
    display: none;
  }
  .video-player[data-muted="true"] .video-player__sound-on {
    display: none;
  }
  .video-player[data-muted="true"] .video-player__sound-off {
    display: block;
  }
  .video-player:fullscreen {
    display: flex;
    max-width: none !important;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
  }
  .video-player:fullscreen .video-player__stage {
    height: 100%;
    max-height: none;
    aspect-ratio: auto;
    border-radius: 0;
  }
  .video-player:fullscreen .video-player__controls {
    padding-bottom: max(8px, env(safe-area-inset-bottom));
    border-radius: 0;
  }
  .video-player[data-state="playing"][data-controls-hidden="true"]:not(
      :has(:focus-visible)
    ):not(:has(details[open]))
    :is(.video-player__controls, .video-player__center-play) {
    opacity: 0;
    pointer-events: none;
  }
  .video-player:has(details[open])
    .video-player__center-play:not(:focus-visible),
  .video-player[data-state="playing"]
    .video-player__center-play:not(:focus-visible) {
    opacity: 0;
    pointer-events: none;
  }
  @supports (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .video-player {
      --vp-material: var(--vp-glass);
      --vp-center-material: rgb(28 28 30 / 55%);
    }
  }
  @media (max-width: 480px) {
    .video-player__center-play {
      width: 64px;
      height: 64px;
    }
    .video-player__center-play svg {
      width: 34px;
      height: 34px;
    }
    .video-player__controls {
      padding-inline: 8px;
    }
    .video-player__time {
      font-size: 12px;
    }
  }
  @media (pointer: coarse) {
    .video-player__volume {
      display: none !important;
    }
    .video-player__volume-label {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-player__controls,
    .video-player__center-play {
      transition: none;
    }
    .video-player__center-play:active {
      transform: none;
    }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .video-player {
      --vp-material: var(--vp-surface);
      --vp-center-material: #333336;
      --vp-blur: 0px;
    }
  }
  @media (prefers-contrast: more) {
    .video-player {
      --vp-line: currentColor;
    }
  }
</style>
