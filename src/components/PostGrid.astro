---
import FormattedDate from "./FormattedDate.astro";
import type { PostListItem } from "../lib/blog";

interface Props {
  posts: PostListItem[];
  currentLang: "en" | "zh";
  featuredCount?: number;
  sourcePath?: string;
}

const { posts, currentLang, featuredCount = 0, sourcePath } = Astro.props;
---

<section
  class={`grid grid-cols-1 gap-5 ${featuredCount > 0 ? "md:grid-cols-4 xl:grid-cols-6" : "md:grid-cols-2 xl:grid-cols-3"}`}
>
  {
    posts.map(({ post, categoryEntries }, index) => {
      const isFeatured = index < featuredCount;
      const href = `/${post.id.replace(/\.mdx?$/, "")}${sourcePath ? `?from=${encodeURIComponent(sourcePath)}` : ""}`;

      return (
        <a
          href={href}
          class={`group rounded-2xl border border-black/5 bg-white/70 p-3 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-lg dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10 ${featuredCount > 0 ? (isFeatured ? "md:col-span-4 xl:col-span-3" : "md:col-span-2 xl:col-span-2") : ""}`}
        >
          {post.data.heroImage && (
            <img
              width={720}
              height={360}
              src={post.data.heroImage}
              alt={post.data.heroImageAlt || ""}
              class="aspect-[16/9] w-full rounded-xl object-cover transition-transform duration-300 group-hover:scale-[1.01]"
              transition:name={`${post.id}-image`}
            />
          )}
          <div class="mt-3 flex flex-col gap-2">
            {categoryEntries.length > 0 && (
              <ul class="flex flex-wrap items-start gap-2">
                {categoryEntries.map((category) => (
                  <li transition:name={`${post.id}-category-${category.id}`}>
                    <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs text-gray-600 dark:bg-white/10 dark:text-white/70">
                      {category.data.name[currentLang]}
                    </span>
                  </li>
                ))}
              </ul>
            )}
            <h2
              class={`font-semibold tracking-tight text-gray-900 dark:text-white ${isFeatured ? "text-2xl md:text-3xl" : "text-xl"}`}
              transition:name={`${post.id}-title`}
            >
              {post.data.title}
            </h2>
            <div class="text-sm text-gray-500 dark:text-white/50">
              <FormattedDate date={post.data.pubDate} />
            </div>
          </div>
        </a>
      );
    })
  }
</section>
